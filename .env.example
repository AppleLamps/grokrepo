XAI_API_KEY=
GROK_MODEL=grok-4.3
GROK_IMAGE_MODEL=grok-imagine-image-quality
GROK_BASE_URL=https://api.x.ai/v1

# Set to true to exercise the local chat loop without calling the API.
GROKCODE_MOCK=false

# UI options: dark, light, compact.
GROKCODE_THEME=dark

# Write redacted debug events to .workspace/logs/grokcode-debug.log.
GROKCODE_DEBUG=false
